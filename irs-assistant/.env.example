POSTGRES_URL=postgresql://irs:irs@localhost:5432/irs_assistant
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text:latest
GENERATION_MODEL=llama3.1:8b
EMBED_DIMENSION=768
TOP_K=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
FEEDBACK_DB=feedback.sqlite

# Inference backend: "ollama" (default, local) or "groq" (cloud)
INFERENCE_BACKEND=ollama
# Required when INFERENCE_BACKEND=groq. Get a free key at console.groq.com
GROQ_API_KEY=
# When using Groq, set GENERATION_MODEL to a Groq model tag, e.g.:
# GENERATION_MODEL=llama-3.3-70b-versatile
